<Window x:Class="deepseek_copilot.ScreenCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        mc:Ignorable="d"
        Title="屏幕截图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        ui:ThemeManager.RequestedTheme="Dark">
    <Grid>
        <Canvas x:Name="RootCanvas" Background="Transparent">
            <Image x:Name="ScreenImage" Stretch="Fill"/>
            <Rectangle x:Name="DarkLeft" Fill="#8A000000"/>
            <Rectangle x:Name="DarkTop" Fill="#8A000000"/>
            <Rectangle x:Name="DarkRight" Fill="#8A000000"/>
            <Rectangle x:Name="DarkBottom" Fill="#8A000000"/>
            <Border x:Name="SelectionBorder"
                    BorderBrush="#FF4FC3F7"
                    BorderThickness="1"
                    Background="Transparent"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>
            <StackPanel x:Name="ActionPanel"
                        Orientation="Horizontal"
                        Visibility="Collapsed"
                        Panel.ZIndex="10">
                <Button x:Name="CancelButton" Content="✕ 取消" Click="OnCancelClick"
                        Width="80" Height="34" Margin="0"
                        ui:ControlHelper.CornerRadius="4"
                        Background="#555555" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontSize="13"/>
                <Button x:Name="ConfirmButton" Content="✓ 确定" Click="OnConfirmClick"
                        Width="80" Height="34" Margin="6,0,0,0"
                        ui:ControlHelper.CornerRadius="4"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontSize="13"/>
            </StackPanel>
        </Canvas>
        <TextBlock x:Name="HintText"
                   Text="拖动鼠标框选截图区域，Esc 取消"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,12,0,0"
                   FontSize="13"
                   Foreground="White"
                   Background="#66000000"
                   Padding="12,6"
                   IsHitTestVisible="False"
                   Panel.ZIndex="20"/>
    </Grid>
</Window>
